# ── Jaringan (Robinhood Chain) ─────────────────────────────
# Isi dengan RPC URL & chain ID resmi Robinhood Chain (lihat docs Robinhood / explorer).
RPC_URL=
CHAIN_ID=
# Opsional, untuk link di pengumuman, mis. https://explorer.xxx
EXPLORER_URL=

# ── Wallet distributor ─────────────────────────────────────
# Wallet KHUSUS untuk bot. Kirim fee hasil klaim Long.xyz ke wallet ini.
# JANGAN pakai wallet utama / wallet creator. JANGAN commit file .env.
DISTRIBUTOR_PRIVATE_KEY=0x...

# ── Token Anda (hasil launch di Long.xyz) ──────────────────
TOKEN_ADDRESS=0x...
# Nomor blok saat token dibuat (lihat di explorer) — awal pemindaian holder
TOKEN_DEPLOY_BLOCK=0

# ── Apa yang dibagikan ─────────────────────────────────────
# "native" = ETH, atau alamat ERC-20. Untuk dividen $AI: isi alamat token $AI.
PAYOUT_TOKEN=native
# Porsi saldo wallet yang dibagikan tiap putaran (10000 = 100%, 7000 = 70%)
DISTRIBUTE_BPS=10000
# Bagian untuk wallet operasional (1000 = 10%). Sisanya (90%) ke holder.
OPERATIONS_WALLET=
OPERATIONS_BPS=1000
# ETH yang disisakan untuk bayar gas (hanya dipakai kalau PAYOUT_TOKEN=native)
GAS_RESERVE=0.005
# Jangan distribusi kalau pool di bawah ini (hemat gas)
MIN_POOL=0.01
# Jatah di bawah ini ditahan & diakumulasi ke putaran berikutnya
MIN_PAYOUT=0.0001

# ── Auto-swap fee → token payout ($AI) ─────────────────────
# Fee dari pair masuk dalam 2 token: token Anda + $AI. Bagian token Anda
# ditukar otomatis ke $AI sebelum dibagikan. Kosongkan SWAP_ROUTER = tanpa swap.
SWAP_ROUTER=
# v2 = router gaya Uniswap V2, v3 = SwapRouter02 Uniswap V3 (butuh SWAP_QUOTER = QuoterV2)
SWAP_ROUTER_TYPE=v2
SWAP_QUOTER=
# Fee tier pool V3 (500 / 3000 / 10000)
SWAP_FEE_TIER=3000
# Token yang dijual (default: TOKEN_ADDRESS)
SWAP_TOKEN_IN=
# Toleransi slippage (300 = 3%)
SWAP_SLIPPAGE_BPS=300
# Minimum & maksimum token yang dijual per putaran (0 = tanpa batas).
# Batasi supaya penjualan fee tidak menekan harga token Anda.
SWAP_MIN_AMOUNT=0
SWAP_MAX_AMOUNT=0

# ── Siapa yang berhak ──────────────────────────────────────
# Minimum saldo token Anda untuk ikut pembagian (satuan token, bukan wei)
MIN_HOLDING=0
# Alamat yang dikecualikan (wallet dev, CEX, dll), pisahkan dengan koma
EXCLUDED_ADDRESSES=
# true = semua smart contract (pool LP, kontrak Long.xyz, dll) otomatis dikecualikan
EXCLUDE_CONTRACTS=true

# ── Pengiriman ─────────────────────────────────────────────
# Alamat kontrak Disperse (contracts/Disperse.sol) — kirim ke banyak holder dalam 1 tx.
# Kosongkan = 1 transaksi per holder (lebih boros gas).
DISPERSE_ADDRESS=
BATCH_SIZE=100

# ── Jadwal & keamanan ──────────────────────────────────────
INTERVAL_MINUTES=60
CONFIRMATIONS=5
LOG_BLOCK_RANGE=10000
# true = hanya simulasi, tidak mengirim apa pun. Ubah ke false kalau sudah yakin.
DRY_RUN=true
STATE_PATH=data/state.json

# ── Pengumuman Telegram (opsional) ─────────────────────────
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
